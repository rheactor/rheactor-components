{
  "name": "@rheactor/rheactor-components",
  "version": "2.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#storybook/*": "./.storybook/*",
    "#assets/*": "./public/assets/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./Client": {
      "types": "./dist/index-client.d.ts",
      "default": "./dist/index-client.js"
    },
    "./Client/Next": {
      "types": "./dist/index-client-next.d.ts",
      "default": "./dist/index-client-next.js"
    },
    "./Client/Slider": {
      "types": "./dist/index-client-slider.d.ts",
      "default": "./dist/index-client-slider.js"
    },
    "./Client/Style": {
      "types": "./dist/index-client-style.d.ts",
      "default": "./dist/index-client-style.js"
    },
    "./Client/Third": {
      "types": "./dist/index-client-third.d.ts",
      "default": "./dist/index-client-third.js"
    },
    "./Client/Media": {
      "types": "./dist/index-client-media.d.ts",
      "default": "./dist/index-client-media.js"
    },
    "./Dom": {
      "types": "./dist/index-dom.d.ts",
      "default": "./dist/index-dom.js"
    },
    "./Next": {
      "types": "./dist/index-next.d.ts",
      "default": "./dist/index-next.js"
    },
    "./Media": {
      "types": "./dist/index-media.d.ts",
      "default": "./dist/index-media.js"
    },
    "./theme.css": {
      "default": "./src/theme.css"
    }
  },
  "scripts": {
    "build": "bun run lint && tsdown",
    "dev": "storybook dev -p 9009",
    "lint": "bun run typecheck && bun run oxlint && bun run oxfmt",
    "lint:fix": "bun run typecheck && bun run oxlint:fix && bun run oxfmt:fix",
    "oxfmt": "oxfmt --check ./.storybook ./src",
    "oxfmt:fix": "oxfmt --write ./.storybook ./src",
    "oxlint": "oxlint ./.storybook ./src",
    "oxlint:fix": "oxlint --fix ./.storybook ./src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rheactor/rheactor-core": "github:rheactor/rheactor-core",
    "@rheactor/rheactor-font-awesome": "^7.3.1"
  },
  "devDependencies": {
    "@next/third-parties": "^16.3.1",
    "@rheactor/rheactor-oxc-config": "github:rheactor/rheactor-oxc-config",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/nextjs": "^10.5.10",
    "@storybook/react": "^10.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "domhandler": "^6.0.1",
    "get-video-id": "^4.2.0",
    "htmlparser2": "^12.0.0",
    "next": "^16.3.1",
    "oxfmt": "^0.64.0",
    "react-style-stringify": "^1.2.0",
    "storybook": "^10.5.10",
    "style-to-js": "^2.0.2",
    "swiper": "^14.1.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "peerDependencies": {
    "@next/third-parties": "^16.3.1",
    "domhandler": "^6.0.1",
    "get-video-id": "^4.2.0",
    "htmlparser2": "^12.0.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-style-stringify": "^1.2.0",
    "style-to-js": "^2.0.2",
    "swiper": "^14.1.0"
  },
  "peerDependenciesMeta": {
    "@next/third-parties": {
      "optional": true
    },
    "domhandler": {
      "optional": true
    },
    "get-video-id": {
      "optional": true
    },
    "htmlparser2": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-style-stringify": {
      "optional": true
    },
    "style-to-js": {
      "optional": true
    },
    "swiper": {
      "optional": true
    }
  }
}
